# Used when the API runs on the host (npm run dev) instead of in compose.
# Inside Docker the proxy target is the `backend` service name.
VITE_API_TARGET=http://localhost:8000

# Relative in both cases, so the browser only ever talks to one origin.
VITE_API_BASE=/api
VITE_WS_BASE=/api/ws
VITE_MAX_UPLOAD_MB=500
VITE_MAX_MAP_MB=10
