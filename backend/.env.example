# Empty values fall back to the binaries shipped by ffmpeg-static / ffprobe-static.
REVCOMP_FFMPEG_PATH=
REVCOMP_FFPROBE_PATH=

REVCOMP_PORT=8000
REVCOMP_MAX_UPLOAD_MB=500
REVCOMP_MAX_MAP_MB=10
REVCOMP_JOB_TTL_HOURS=24
REVCOMP_MAX_CONCURRENT_JOBS=1

REVCOMP_DEFAULT_MODE=stream
REVCOMP_DEFAULT_CODEC=libx264
REVCOMP_DEFAULT_PRESET=medium
REVCOMP_DEFAULT_CRF=23
REVCOMP_TUBE_DURATION_SEC=1.0

# Only used by mode=reencode (CFR normalisation before segmentation).
REVCOMP_TARGET_FPS=30
REVCOMP_KEYFRAME_INTERVAL_SEC=2

REVCOMP_CORS_ORIGINS=http://localhost:5173
REVCOMP_LOG_LEVEL=INFO
REVCOMP_LOG_FORMAT=json
